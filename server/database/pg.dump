--
-- Name: check_and_delete_orphan_location(); Type: FUNCTION; Schema: public; Owner: selab2
--

CREATE FUNCTION public.check_and_delete_orphan_location() RETURNS trigger
    LANGUAGE plpgsql
    AS $$
BEGIN
    IF NOT EXISTS (SELECT 1 FROM event_locations WHERE location_id = OLD.location_id) THEN
        DELETE FROM locations WHERE id = OLD.location_id;
    END IF;

    RETURN OLD;
END;
$$;


ALTER FUNCTION public.check_and_delete_orphan_location() OWNER TO selab2;

--
-- Name: check_and_delete_orphan_tag(); Type: FUNCTION; Schema: public; Owner: selab2
--

CREATE FUNCTION public.check_and_delete_orphan_tag() RETURNS trigger
    LANGUAGE plpgsql
    AS $$
BEGIN
    IF NOT EXISTS (SELECT 1 FROM production_tag WHERE tag_id = OLD.tag_id) THEN
        DELETE FROM tags WHERE id = OLD.tag_id;
    END IF;

    RETURN OLD;
END;
$$;


ALTER FUNCTION public.check_and_delete_orphan_tag() OWNER TO selab2;

