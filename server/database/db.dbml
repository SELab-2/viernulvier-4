// -------------------------------------------------------
// Core Content
// -------------------------------------------------------

Table productions {
  id int [pk, increment]
  titel jsonb
  ondertitel jsonb
  description1 jsonb
  description2 jsonb
  planning_id text
  artist jsonb
  tagline jsonb
  credits jsonb
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]
  legacy_id text [unique]
  performer_type text
  attendance_mode text
}

Table series {
  id int [pk, increment]
  titel jsonb [not null]
  description jsonb
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]
}

Table events {
  id int [pk, increment]
  titel jsonb
  starttime timestamp [not null]
  endtime timestamp [not null]
  doors_at timestamp
  intermission_at timestamp
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]
  production_id int [not null]
  legacy_id text [unique]

  indexes {
    production_id
    starttime
  }
}

Table blogs {
  id int [pk, increment]
  titel jsonb [not null]
  description jsonb [not null]
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]
}

Table print_items {
  id int [pk, increment]
  titel jsonb
  description jsonb
  url text
  print_type enum_type
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]
}

Table tags {
  id int [pk, increment]
  titel jsonb [not null, unique] 
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]
  legacy_id text [unique]
}

Table locations {
  id int [pk]
  titel jsonb [not null, unique]
  description jsonb
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]
  legacy_id text [unique]
}

Table prices {
  id int [pk, increment]
  titel jsonb [not null]
  price numeric(10,2) [not null]
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]
  legacy_id text [unique]
}

// -------------------------------------------------------
// Media System
// -------------------------------------------------------

Table media_gallery {
  id int [pk, increment]
  titel varchar(255) 
  type gallery_type
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]
  legacy_id varchar(255) [unique]

  indexes {
    legacy_id
  }
}

Table media_item {
  id int [pk, increment]
  titel jsonb
  description jsonb
  type varchar(100) [not null]
  original_filename varchar(500) [not null]
  position ItemPositionEnum
  width int
  height int
  credits jsonb
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]
  legacy_id varchar(255) [unique]

  indexes {
    legacy_id
    position
  }
}

Table media_crop {
  id int [pk, increment]
  titel crop_name [not null]
  url text [not null]
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]
  legacy_id varchar(255) [unique]

  indexes {
    legacy_id
    titel
  }
}

// -------------------------------------------------------
// System & Auth
// -------------------------------------------------------

Table accounts {
  id int [pk, increment]
  username varchar(255) [not null, unique]
  password varchar(255) [not null]
  super_admin boolean [not null, default: false]
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]
}

Table api_keys {
  id int [pk, increment]
  key varchar(255) [not null, unique]
  active boolean [not null, default: true]
  super_key boolean [not null, default: false]
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]
}

Table scraper_dates {
  id int [pk, increment]
  date timestamp [default: `'1970-01-01 00:00:00'`]
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]
}

// -------------------------------------------------------
// Relations (Pivot Tables)
// -------------------------------------------------------

Table production_series {
  production_id int [not null, ref: > productions.id]
  series_id int [not null, ref: > series.id]
  indexes { 
    (production_id, series_id) [pk] 
    series_id
  }
}

Table production_blogs {
  production_id int [not null, ref: > productions.id]
  blog_id int [not null, ref: > blogs.id]
  indexes { 
    (production_id, blog_id) [pk] 
    blog_id
  }
}

Table production_tag {
  production_id int [not null, ref: > productions.id]
  tag_id int [not null, ref: > tags.id]
  indexes { 
    (production_id, tag_id) [pk] 
    tag_id
  }
}

Table event_locations {
  event_id int [not null, ref: > events.id]
  location_id int [not null, ref: > locations.id]
  indexes { 
    (event_id, location_id) [pk] 
    location_id
  }
}

Table account_api_keys {
  account_id int [not null, ref: > accounts.id]
  api_key_id int [not null, ref: > api_keys.id]
  indexes { 
    (account_id, api_key_id) [pk] 
    api_key_id
  }
}

Table event_prices {
  event_id int [not null, ref: > events.id]
  price_id int [not null, ref: > prices.id]
  indexes { 
    (event_id, price_id) [pk] 
    price_id
  }
}

Table gallery_item {
  gallery_id int [not null, ref: > media_gallery.id]
  item_id int [not null, ref: > media_item.id]
  indexes { 
    (gallery_id, item_id) [pk] 
    item_id
  }
}

Table item_crop {
  item_id int [not null, ref: > media_item.id]
  crop_id int [not null, ref: > media_crop.id]
  indexes { 
    (item_id, crop_id) [pk] 
    crop_id
  }
}

Table production_media_gallery {
  production_id int [not null, ref: > productions.id]
  gallery_id int [not null, ref: > media_gallery.id]
  indexes { 
    (production_id, gallery_id) [pk] 
    gallery_id
  }
}

Table blog_media_gallery {
  blog_id int [not null, ref: > blogs.id]
  gallery_id int [not null, ref: > media_gallery.id]
  indexes { 
    (blog_id, gallery_id) [pk] 
    gallery_id
  }
}

Table print_item_media_gallery {
  print_item_id int [not null, ref: > print_items.id]
  media_gallery_id int [not null, ref: > media_gallery.id]
  indexes { 
    (print_item_id, media_gallery_id) [pk] 
    media_gallery_id
  }
}