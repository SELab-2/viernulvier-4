Table productions {
  id int [pk, increment]
  titel jsonb
  ondertitel jsonb
  description1 jsonb
  description2 jsonb
  planning_id text
  artist jsonb
  tagline jsonb
  credits jsonb
  created_at timestamp [default: `now()`]
  updated_at timestamp [default: `now()`]
  legacy_id text [unique]
  performer_type text
  attendance_mode text
}

Table events {
  id int [pk, increment]
  starttime timestamp [not null]
  endtime timestamp [not null]
  doors_at timestamp
  intermission_at timestamp
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]
  production_id int [not null]
  legacy_id text [unique]

  indexes {
    production_id
    starttime
  }
}

Table blogs {
  id int [pk, increment]
  titel jsonb [not null]
  description jsonb [not null]
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]
}

Table print_items {
  id int [pk, increment]
  titel jsonb
  description jsonb
  url text
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]
}

Table production_blogs {
  production_id int [not null]
  blog_id int [not null]

  indexes {
    (production_id, blog_id) [pk]
    blog_id
  }
}

Table tags {
  id int [pk, increment]
  tag jsonb [not null, unique]
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]
  legacy_id text [unique]
}

Table production_tag {
  production_id int [not null]
  tag_id int [not null]

  indexes {
    (production_id, tag_id) [pk]
    tag_id
  }
}

Table locations {
  id int [pk]
  location jsonb [not null, unique]
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]
  legacy_id text [unique]
}

Table event_locations {
  event_id int [not null]
  location_id int [not null]

  indexes {
    (event_id, location_id) [pk]
    location_id
  }
}

Table accounts {
  id int [pk, increment]
  username varchar(255) [not null, unique]
  password varchar(255) [not null]
  super_admin boolean [not null, default: false]
}

Table api_keys {
  id int [pk, increment]
  key varchar(255) [not null, unique]
  active boolean [not null, default: true]
  super_key boolean [not null, default: false]
}

Table account_api_keys {
  account_id int [not null]
  api_key_id int [not null]

  indexes {
    (account_id, api_key_id) [pk]
    api_key_id
  }
}

Table prices {
  id int [pk, increment]
  name jsonb [not null]
  price numeric(10,2) [not null]
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]
  legacy_id text [unique]
}

Table event_prices {
  event_id int [not null]
  price_id int [not null]

  indexes {
    (event_id, price_id) [pk]
    price_id
  }
}

Table scraper_dates {
  id int [pk, increment]
  date timestamp [default: `'1970-01-01 00:00:00'`]
}

// -------------------------------------------------------
// Media
// -------------------------------------------------------

Table media_gallery {
  id int [pk, increment]
  legacy_id varchar(255) [unique]
  name varchar(255)
  type gallery_type
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]

  indexes {
    legacy_id
  }
}

Table media_item {
  id int [pk, increment]
  legacy_id varchar(255) [unique]
  type varchar(100) [not null]
  original_filename varchar(500) [not null]
  position ItemPositionEnum
  width int
  height int
  credits jsonb
  description jsonb
  title jsonb
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]

  indexes {
    legacy_id
    position
  }
}

Table media_crop {
  id int [pk, increment]
  legacy_id varchar(255) [unique]
  name crop_name [not null]
  url text [not null]
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]

  indexes {
    legacy_id
    name
  }
}

Table gallery_item {
  gallery_id int [not null]
  item_id int [not null]

  indexes {
    (gallery_id, item_id) [pk]
    item_id
  }
}

Table item_crop {
  item_id int [not null]
  crop_id int [not null]

  indexes {
    (item_id, crop_id) [pk]
    crop_id
  }
}

Table production_media_gallery {
  production_id int [not null]
  gallery_id int [not null]

  indexes {
    (production_id, gallery_id) [pk]
    gallery_id
  }
}

Table blog_media_gallery {
  blog_id int [not null]
  gallery_id int [not null]

  indexes {
    (blog_id, gallery_id) [pk]
    gallery_id
  }
}

Table print_item_media_gallery {
  print_item_id int [not null]
  media_gallery_id int [not null]

  indexes {
    (print_item_id, media_gallery_id) [pk]
    media_gallery_id
  }
}

// -------------------------------------------------------
// Refs
// -------------------------------------------------------

Ref: events.production_id > productions.id [delete: cascade]

Ref: production_blogs.production_id > productions.id [delete: cascade]
Ref: production_blogs.blog_id > blogs.id [delete: cascade]

Ref: production_tag.production_id > productions.id [delete: cascade]
Ref: production_tag.tag_id > tags.id [delete: cascade]

Ref: event_locations.event_id > events.id [delete: cascade]
Ref: event_locations.location_id > locations.id [delete: cascade]

Ref: account_api_keys.account_id > accounts.id [delete: cascade]
Ref: account_api_keys.api_key_id > api_keys.id [delete: cascade]

Ref: event_prices.event_id > events.id [delete: cascade]
Ref: event_prices.price_id > prices.id [delete: cascade]

Ref: gallery_item.gallery_id > media_gallery.id [delete: cascade]
Ref: gallery_item.item_id > media_item.id [delete: cascade]

Ref: item_crop.item_id > media_item.id [delete: cascade]
Ref: item_crop.crop_id > media_crop.id [delete: cascade]

Ref: production_media_gallery.production_id > productions.id [delete: cascade]
Ref: production_media_gallery.gallery_id > media_gallery.id [delete: cascade]

Ref: blog_media_gallery.blog_id > blogs.id [delete: cascade]
Ref: blog_media_gallery.gallery_id > media_gallery.id [delete: cascade]

Ref: print_item_media_gallery.print_item_id > print_items.id [delete: cascade]
Ref: print_item_media_gallery.media_gallery_id > media_gallery.id [delete: cascade]