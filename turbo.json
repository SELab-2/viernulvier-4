{
  "$schema": "https://turborepo.dev/schema.json",
  "tasks": {
    "scraper:inject:structured:test": {},
    "db:reset": {},
    "build": {
      "outputs": ["dist/**"]
    },
    "check-types": {
      "dependsOn": ["^check-types"]
    },
    "start:dev": {
      "persistent": true,
      "cache": false
    },
    "start:prod": {
      "dependsOn": ["build"],
      "cache": false,
      "persistent": true
    },
    "test": {
      "outputs": [],
      "inputs": [
        "app/**",
        "tests/**",
        "src/**",
        "test/**",
        "vitest.config.ts",
        "jest.config.ts",
        "package.json",
        "tsconfig.json"
      ]
    },
    "test:coverage": {
      "outputs": [],
      "inputs": [
        "app/**",
        "tests/**",
        "src/**",
        "test/**",
        "vitest.config.ts",
        "jest.config.ts",
        "package.json",
        "tsconfig.json"
      ]
    }
  }
}
