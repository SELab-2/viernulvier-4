# Example environment file — copy this to .env and fill in the correct values for your installation.
# Rename this file to .env once done. Never commit .env to version control.

# PostgreSQL connection
DB_USER=your_db_user
DB_HOST=127.0.0.1
DB_NAME=your_db_name
DB_PASSWORD=your_db_password
DB_PORT=5432

# API key used to authenticate client requests (see database page for details)
CLIENT_API_KEY=your_api_key_here

# Enable or disable the built-in scraper (true/false)
ENABLE_SCRAPER=false

# The absolute path to the logging directory
LOGGER_PATH=/absolute/path/to/your/dir

# the api-key for the translate API:
TRANSLATE_API_KEY=your-api-key-here

# the base-url of the media hosting server:
# note this is the root of all media types so http://example.org and under that you may have /photos and /prints
MEDIA_API_URL=https://www.viernulvier.gent
MEDIA_BASE_URL=your-base-url-here
DOWNLOAD_MEDIA=false

# Paths to legacy CSV files used by old CSV injection
OLD_CSV_PRODUCTIONS_FILE=../common/res/productions_output.csv
OLD_CSV_EVENTS_FILE=../common/res/events_voorstellingen.csv

